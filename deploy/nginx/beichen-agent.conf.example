# Beichen Agent Nginx example for a single Ubuntu VPS.
# Replace example.com with your real domain before enabling this file.
# Frontend files are copied from frontend/dist to /opt/beichen-agent/frontend_dist.

server {
    listen 80;
    server_name example.com www.example.com;

    root /opt/beichen-agent/frontend_dist;
    index index.html;

    # React/Vite single page app fallback.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # FastAPI backend. Keep the backend bound to 127.0.0.1:8000.
    location /api/ {
        proxy_pass http://127.0.0.1:8000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 25m;
    }

    # /health/config is also matched here.
    location /health {
        proxy_pass http://127.0.0.1:8000/health;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
