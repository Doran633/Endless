# Backend application
APP_NAME=Beichen Agent Backend

# Optional shared access password for public deployment.
# Leave empty for local development. Never commit a real password.
APP_ACCESS_PASSWORD=
APP_ACCESS_HEADER=X-Beichen-Access

# Optional comma-separated 6-digit invite codes.
# If set, APP_INVITE_CODES takes precedence over APP_ACCESS_PASSWORD.
# Example only: APP_INVITE_CODES=123456,654321
APP_INVITE_CODES=

# LLM provider: mock for local development without an API key, openai for real calls.
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30

# Embedding provider: mock for local development, openai for real embeddings.
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=mock-embedding
EMBEDDING_DIMENSION=16
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1

# OpenAI-compatible provider. Never commit a real API key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# File upload
UPLOAD_DIR=uploads
VECTOR_STORE_DIR=vector_store
MAX_UPLOAD_SIZE_MB=20
ALLOWED_UPLOAD_EXTENSIONS=txt,pdf,docx

# RAG evaluation and tuning defaults.
# Keep these defaults unless you are running controlled RAG evaluation.
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RAG_DEFAULT_TOP_K=3
RAG_SCORE_THRESHOLD=0
RAG_RELATIVE_SCORE_GAP=0.20
RAG_KEYWORD_BONUS_MAX=0.04

# SQLite persistence
DATABASE_PATH=data/beichen.db

# Local logging
LOG_LEVEL=INFO
LOG_TO_FILE=false
LOG_DIR=logs
